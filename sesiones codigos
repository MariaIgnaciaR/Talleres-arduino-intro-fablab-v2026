# Actividad 1 — Blink (LED integrado)
void setup() {
  pinMode(13, OUTPUT); #tambien puede ser en vez de 13 -> LED_BUILTIN
}
void loop() {
  digitalWrite(13, HIGH);
  delay(1000); #en miliseg o sea 1000*1/1000 = 1seg
  digitalWrite(13, LOW);
  delay(1000);
}

