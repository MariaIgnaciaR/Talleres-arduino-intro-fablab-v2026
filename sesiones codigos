# Actividad 6 — LED con brillo variable (potenciómetro)
int pot = A0;
int led = 9;
void setup() {
  pinMode(led, OUTPUT);
}
void loop() {
  int valor = analogRead(pot);
  int brillo = map(valor, 0, 1023, 0, 255);
  analogWrite(led, brillo);
}

# Actividad 7 — Sistema reactivo (LDR + LED)
int ldr = A0;
int led = 9;
void setup() {
  pinMode(led, OUTPUT);
}
void loop() {
  int valor = analogRead(ldr);
  if (valor < 300) {
    digitalWrite(led, HIGH);
  } else {
    digitalWrite(led, LOW);
  }
}


