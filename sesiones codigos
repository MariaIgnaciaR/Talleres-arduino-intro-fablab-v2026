# Actividad 8 — Control de Servomotor
#include <Servo.h>
Servo miServo;
void setup() {
  miServo.attach(9);
}
void loop() {
  miServo.write(0);
  delay(1000);
  miServo.write(90);
  delay(1000);
  miServo.write(180);
  delay(1000);
}

# Actividad 9 — Botón + Buzzer
int boton = 2;
int buzzer = 8;
void setup() {
  pinMode(boton, INPUT_PULLUP);
  pinMode(buzzer, OUTPUT);
}
void loop() {
  if (digitalRead(boton) == LOW) {
    tone(buzzer, 1000);
  } else {
    noTone(buzzer);
  }
}

